{"inkVersion":21,"root":[[{"->":"opening"},["done",{"#n":"g-0"}],null],"done",{"nowhere":["done",{"#f":3}],"movement":["ev",{"VAR?":"travel_text"},"out","/ev","\n",{"->":"destination","var":true},null],"bar_is_lit":["ev",{"VAR?":"cloak_place"},0,"!=","/ev","~ret",null],"disturb":[{"temp=":"amount"},"ev",{"VAR?":"disturbance"},{"VAR?":"amount"},"+","/ev",{"VAR=":"disturbance","re":true},null],"opening":["^Hurrying through the rainswept November night, you're glad to see the","\n","^bright lights of the Opera House. It's surprising that there aren't more","\n","^people about but, hey, what do you expect in a cheap demo game...?","\n",{"->":"foyer"},null],"foyer":[["ev","str","^foyer","/str","/ev",{"VAR=":"current_location","re":true},"^You are standing in a spacious hall, splendidly decorated in red and","\n","^gold, with glittering chandeliers overhead. The entrance from the street","\n","^is to the north, and there are doorways south and west.","\n","ev","str","^Go south, to the bar","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Go west, to the cloakroom","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^Go north, to the street","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^Check what you are carrying","/str","/ev",{"*":".^.c-3","flg":4},"ev","str","^GO","/str","/ev",{"*":".^.c-4","flg":4},{"c-0":["^ ",{"->":"bar"},"\n",null],"c-1":["^ ",{"->":"cloakroom"},"\n",null],"c-2":["^ ",{"->":"street_refused"},"\n",null],"c-3":["^ ",{"->":"foyer_inventory"},"\n",null],"c-4":["^ ",{"->":"movement"},"\n",null]}],null],"street_refused":["^You've only just arrived, and besides, the weather outside seems to be","\n","^getting worse.","\n",{"->":"foyer"},null],"foyer_inventory":["ev",{"VAR?":"cloak_place"},0,"==","/ev",[{"->":".^.b","c":true},{"b":["\n","^You are wearing a black velvet cloak.","\n",{"->":".^.^.^.7"},null]}],[{"->":".^.b"},{"b":["\n","^You are carrying nothing.","\n",{"->":".^.^.^.7"},null]}],"nop","\n",{"->":"foyer"},null],"cloakroom":[["ev","str","^cloakroom","/str","/ev",{"VAR=":"current_location","re":true},"^The walls of this small room were clearly once lined with hooks, though","\n","^now only one remains. The exit is a door to the east.","\n","ev","str","^Examine the hook","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Hang the cloak on the hook","/str",{"VAR?":"cloak_place"},0,"==","/ev",{"*":".^.c-1","flg":5},"ev","str","^Drop the cloak on the floor","/str",{"VAR?":"cloak_place"},0,"==","/ev",{"*":".^.c-2","flg":5},"ev","str","^Take the cloak from the hook","/str",{"VAR?":"cloak_place"},1,"==","/ev",{"*":".^.c-3","flg":5},"ev","str","^Pick the cloak up off the floor","/str",{"VAR?":"cloak_place"},2,"==","/ev",{"*":".^.c-4","flg":5},"ev","str","^Go east, to the foyer","/str","/ev",{"*":".^.c-5","flg":4},"ev","str","^GO","/str","/ev",{"*":".^.c-6","flg":4},{"c-0":["^ ",{"->":"hook_description"},"\n",null],"c-1":["^ ",{"->":"hang_cloak"},"\n",null],"c-2":["^ ",{"->":"drop_cloak"},"\n",null],"c-3":["^ ",{"->":"take_cloak"},"\n",null],"c-4":["^ ",{"->":"take_cloak"},"\n",null],"c-5":["^ ",{"->":"foyer"},"\n",null],"c-6":["^ ",{"->":"movement"},"\n",null]}],null],"hook_description":["^It's just a small brass hook, ","ev",{"VAR?":"cloak_place"},1,"==","/ev",[{"->":".^.b","c":true},{"b":["^ with a cloak hanging on it.",{"->":".^.^.^.8"},null]}],[{"->":".^.b"},{"b":["^screwed to the wall.",{"->":".^.^.^.8"},null]}],"nop","\n",{"->":"cloakroom"},null],"hang_cloak":["ev",1,"/ev",{"VAR=":"cloak_place","re":true},"ev",{"VAR?":"hook_point_taken"},"!","/ev",[{"->":".^.b","c":true},{"b":["\n","ev",true,"/ev",{"VAR=":"hook_point_taken","re":true},"ev",{"VAR?":"score"},1,"+","/ev",{"VAR=":"score","re":true},{"->":".^.^.^.9"},null]}],"nop","\n","^You hang the cloak on the hook. The room feels no different, but","\n","^somewhere behind you a light seems to have been let in.","\n",{"->":"cloakroom"},null],"drop_cloak":["ev",2,"/ev",{"VAR=":"cloak_place","re":true},"^You drop the cloak on the floor. It is not the best place for a smart","\n","^cloak, but it is out of your hands.","\n",{"->":"cloakroom"},null],"take_cloak":["ev",0,"/ev",{"VAR=":"cloak_place","re":true},"^You put the cloak back on.","\n",{"->":"cloakroom"},null],"bar":["ev","str","^bar","/str","/ev",{"VAR=":"current_location","re":true},"ev",{"f()":"bar_is_lit"},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"bar_lit"},{"->":"bar.11"},null]}],[{"->":".^.b"},{"b":["\n",{"->":"bar_dark"},{"->":"bar.11"},null]}],"nop","\n",null],"bar_lit":[["^The bar, much rougher than you'd have guessed after the opulence of the","\n","^foyer to the north, is completely empty. There seems to be some sort of","\n","^message scrawled in the sawdust on the floor.","\n","ev","str","^Read the message","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Go north, to the foyer","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^GO","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["^ ",{"->":"read_message"},"\n",null],"c-1":["^ ",{"->":"foyer"},"\n",null],"c-2":["^ ",{"->":"movement"},"\n",null]}],null],"bar_dark":[["^It is pitch dark in here. You can just make out a doorway to the north.","\n","ev","str","^Go north, to the foyer","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Feel around on the floor","/str","/ev",{"*":".^.c-1","flg":4},"ev","str","^GO","/str","/ev",{"*":".^.c-2","flg":4},"ev","str","^Go south, further into the dark","/str","/ev",{"*":".^.c-3","flg":4},"ev","str","^Go east, further into the dark","/str","/ev",{"*":".^.c-4","flg":4},"ev","str","^Go west, further into the dark","/str","/ev",{"*":".^.c-5","flg":4},{"c-0":["^ ",{"->":"foyer"},"\n",null],"c-1":["^ ",{"->":"fumble_in_dark"},"\n",null],"c-2":["^ ",{"->":"movement"},"\n",null],"c-3":["^ ",{"->":"blunder_in_dark"},"\n",null],"c-4":["^ ",{"->":"blunder_in_dark"},"\n",null],"c-5":["^ ",{"->":"blunder_in_dark"},"\n",null]}],null],"fumble_in_dark":["ev",1,{"f()":"disturb"},"pop","/ev","\n","^In the dark? You could easily disturb something!","\n",{"->":"bar"},null],"blunder_in_dark":["ev",